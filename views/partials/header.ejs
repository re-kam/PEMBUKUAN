<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title ? title + ' - ' : '' %>Finance by Cliff · Sistem Akuntansi</title>
<script>try{var _e=document.documentElement;_e.setAttribute('data-theme',localStorage.getItem('theme')||'light');}catch(e){}</script>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
<style>
:root{
  /* Cliff.gosipinbisnis Design System */
  --ink:#0A0A0A; --paper:#FFFFFF; --paper-soft:#F4F4F2;
  --gray-600:#5C5C5C; --gray-500:#7C7C7C; --gray-400:#A0A0A0; --gray-300:#C9C9C9; --gray-200:#E2E2E0;
  --line-hair:rgba(10,10,10,.14);
  --font-display:'Anton','Arial Narrow',sans-serif;
  --font-body:'Montserrat',system-ui,-apple-system,sans-serif;
  --r-md:12px; --r-lg:20px; --r-pill:999px;
  --shadow-lg:0 18px 50px rgba(10,10,10,.16);
  --ease-out:cubic-bezier(.16,1,.3,1);

  --sb:250px;--sbg:var(--ink);--sbh:#1f1f1f;
  --bg:var(--paper-soft);--card:var(--paper);--card-h:var(--paper);--bdr:var(--paper-soft);--bdr-md:var(--line-hair);
  --tx:var(--ink);--tx2:var(--gray-600);--tx3:#6E6E6E;--inp:#fff;
  --pg:#f0fdf4;--pgb:#dcfce7;--pgt:#166534;--pgp:#15803d;
  --pb:#eff6ff;--pbb:#dbeafe;--pbt:#1d4ed8;--pbp:#3b82f6;
  --pr:#fef2f2;--prb:#fee2e2;--prt:#991b1b;--prp:#dc2626;
  --py:#fffbeb;--pyb:#fef3c7;--pyt:#92400e;--pyp:#b45309;
}
[data-theme="dark"]{
  --bg:#0A0A0A;--card:#161616;--card-h:#1f1f1f;--bdr:#2A2A2A;--bdr-md:#3A3A3A;
  --tx:#F4F4F2;--tx2:#C9C9C9;--tx3:#A0A0A0;--inp:#1f1f1f;
  --sbg:#0A0A0A;--sbh:#1f1f1f;
  --pg:rgba(20,83,45,.35);--pgb:#14532d;--pgt:#4ade80;--pgp:#22c55e;
  --pb:rgba(30,58,95,.35);--pbb:#1e3a5f;--pbt:#93c5fd;--pbp:#60a5fa;
  --pr:rgba(127,29,29,.3);--prb:#7f1d1d;--prt:#fca5a5;--prp:#ef4444;
  --py:rgba(146,64,14,.3);--pyb:#78350f;--pyt:#fde68a;--pyp:#fcd34d;
}

body{background:var(--bg);color:var(--tx);font-family:var(--font-body);font-size:.9rem;min-height:100vh;-webkit-font-smoothing:antialiased;transition:background .2s,color .2s}
.sidebar{position:fixed;top:0;left:0;width:var(--sb);height:100vh;background:var(--sbg);overflow-y:auto;z-index:1000}
.sb-brand{padding:1.25rem 1rem;border-bottom:1px solid rgba(255,255,255,.12);display:flex;align-items:center;gap:12px}
.sb-brand img{width:36px;height:36px;object-fit:contain;border-radius:6px;background:#fff;padding:2px}
.sb-brand .brand-name{font-family:var(--font-display);color:var(--paper);font-size:1.15rem;text-transform:uppercase;margin:0;letter-spacing:.02em;line-height:1.1}
.sb-brand .brand-sub{color:rgba(255,255,255,.45);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;font-weight:600;display:block}

.sb-sec{padding:.8rem 1rem .25rem;font-size:.6rem;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.18em;font-weight:700}
.sidebar .nav-link{color:rgba(255,255,255,.7)!important;padding:.5rem .85rem;border-radius:8px 0 0 8px;margin:1px 0 1px 8px;display:flex;align-items:center;gap:.65rem;font-size:.84rem;font-weight:500;text-decoration:none;transition:all .15s var(--ease-out)}
.sidebar .nav-link:hover{background:var(--sbh);color:#fff!important}
.sidebar .nav-link.active{background:var(--paper);color:var(--ink)!important;font-weight:700}
.sidebar .nav-link i{width:18px;text-align:center;font-size:.85rem}
.sidebar .nav-link-pos{color:#facc15!important;font-weight:700}

.main{margin-left:var(--sb);min-height:100vh;display:flex;flex-direction:column}
.topbar{background:var(--card);border-bottom:1px solid var(--bdr-md);padding:.75rem 1.75rem;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100}
.topbar .page-title{font-family:var(--font-display);font-size:1.5rem;text-transform:uppercase;margin:0;letter-spacing:.01em;color:var(--tx)}
.topbar-actions{display:flex;align-items:center;gap:.75rem}

.theme-toggle{background:none;border:1px solid var(--bdr-md);color:var(--tx);padding:.4rem .75rem;border-radius:var(--r-pill);cursor:pointer;font-size:.8rem;font-weight:600}
.body-content{padding:1.5rem 1.75rem;flex:1}

.card{background:var(--card);border:1px solid var(--bdr-md);border-radius:var(--r-md);overflow:hidden}
.card-header{background:var(--card-h);border-bottom:1px solid var(--bdr-md);padding:.85rem 1.25rem;font-weight:700;display:flex;align-items:center;justify-content:space-between}
.btn-ink{background:var(--ink);color:var(--paper);border:none;border-radius:var(--r-pill);padding:.5rem 1.25rem;font-weight:700;font-size:.84rem;display:inline-flex;align-items:center;gap:.5rem;text-decoration:none;transition:transform .12s,box-shadow .12s}
.btn-ink:hover{color:var(--paper);transform:translateY(-1px);box-shadow:var(--shadow-lg)}

.kpi-card{padding:1.25rem;border-radius:var(--r-md);display:flex;align-items:center;gap:1rem}
.kpi-icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.25rem;flex-shrink:0}
.kpi-lbl{font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--tx3);margin-bottom:.25rem}
.kpi-val{font-size:1.45rem;font-weight:800;letter-spacing:-.02em;line-height:1}

.table-custom{width:100%;border-collapse:collapse;margin:0}
.table-custom th{background:var(--card-h);font-size:.65rem;text-transform:uppercase;letter-spacing:.08em;font-weight:700;color:var(--tx3);padding:.65rem 1rem;border-bottom:1px solid var(--bdr-md)}
.table-custom td{padding:.75rem 1rem;border-bottom:1px solid var(--bdr-md);font-size:.84rem;vertical-align:middle}
.table-custom tr:hover td{background:rgba(0,0,0,.02)}
[data-theme="dark"] .table-custom tr:hover td{background:rgba(255,255,255,.02)}

@media(max-width:992px){
  .sidebar{display:none}
  .main{margin-left:0}
}
</style>
</head>
<body>

<!-- Sidebar -->
<aside class="sidebar">
  <div class="sb-brand">
    <img src="/static/brand/finance-by-cliff-login.png" alt="Logo">
    <div>
      <div class="brand-name">Cliff Finance</div>
      <span class="brand-sub">Sistem Akuntansi</span>
    </div>
  </div>

  <div class="sb-sec">Utama</div>
  <a href="/" class="nav-link <%= currentPath === '/' ? 'active' : '' %>">
    <i class="fas fa-chart-pie"></i> Dashboard
  </a>
  <a href="/daftar-transaksi" class="nav-link <%= currentPath === '/daftar-transaksi' ? 'active' : '' %>">
    <i class="fas fa-list-check"></i> Daftar Transaksi
  </a>

  <div class="sb-sec">Transaksi & Kas</div>
  <a href="/pemasukan" class="nav-link <%= currentPath === '/pemasukan' ? 'active' : '' %>">
    <i class="fas fa-arrow-trend-up text-success"></i> Pemasukan / Jual
  </a>
  <a href="/pengeluaran" class="nav-link <%= currentPath === '/pengeluaran' ? 'active' : '' %>">
    <i class="fas fa-arrow-trend-down text-danger"></i> Pengeluaran / Beban
  </a>
  <a href="/pos" class="nav-link nav-link-pos <%= currentPath.startsWith('/pos') ? 'active' : '' %>">
    <i class="fas fa-cash-register"></i> POS Kasir Pintar
  </a>

  <div class="sb-sec">Buku & Laporan</div>
  <a href="/akun" class="nav-link <%= currentPath === '/akun' ? 'active' : '' %>">
    <i class="fas fa-book"></i> Daftar Akun (COA)
  </a>
  <a href="/laba-rugi" class="nav-link <%= currentPath === '/laba-rugi' ? 'active' : '' %>">
    <i class="fas fa-file-invoice-dollar"></i> Laba Rugi
  </a>
  <a href="/neraca" class="nav-link <%= currentPath === '/neraca' ? 'active' : '' %>">
    <i class="fas fa-scale-balanced"></i> Neraca Saldo
  </a>

  <div class="sb-sec">Bisnis & Stok</div>
  <a href="/piutang" class="nav-link <%= currentPath === '/piutang' ? 'active' : '' %>">
    <i class="fas fa-hand-holding-dollar"></i> Piutang Usaha
  </a>
  <a href="/hutang" class="nav-link <%= currentPath === '/hutang' ? 'active' : '' %>">
    <i class="fas fa-receipt"></i> Hutang Pemasok
  </a>
  <a href="/stok" class="nav-link <%= currentPath === '/stok' ? 'active' : '' %>">
    <i class="fas fa-boxes-stacked"></i> Stok & Produk
  </a>

  <div class="sb-sec">Sistem</div>
  <a href="/settings" class="nav-link <%= currentPath === '/settings' ? 'active' : '' %>">
    <i class="fas fa-gear"></i> Pengaturan
  </a>
  <a href="/logout" class="nav-link text-danger">
    <i class="fas fa-right-from-bracket"></i> Keluar
  </a>
</aside>

<!-- Main Wrapper -->
<div class="main">
  <!-- Topbar -->
  <header class="topbar">
    <div>
      <h1 class="page-title"><%= pageTitle || 'Finance by Cliff' %></h1>
    </div>
    <div class="topbar-actions">
      <button class="theme-toggle" id="themeToggleBtn" type="button" title="Ganti Tema">
        <i class="fas fa-moon me-1"></i> <span id="themeLabel">Dark</span>
      </button>
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill px-3" data-bs-toggle="dropdown">
          <i class="fas fa-user-circle me-1"></i> <strong><%= sessionUser ? sessionUser.nama : 'Admin' %></strong>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
          <li><span class="dropdown-item-text text-muted small">Role: <%= sessionUser ? sessionUser.role : 'ADMIN' %></span></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item text-danger" href="/logout"><i class="fas fa-right-from-bracket me-2"></i>Keluar</a></li>
        </ul>
      </div>
    </div>
  </header>

  <!-- Content -->
  <main class="body-content">
