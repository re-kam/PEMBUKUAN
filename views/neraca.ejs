<%- include('partials/header', { pageTitle: 'Neraca Saldo', currentPath: '/neraca' }) %>

<div class="row justify-content-center">
  <div class="col-lg-11">
    <div class="card shadow-sm">
      <div class="card-header bg-dark text-white d-flex align-items-center justify-content-between py-3">
        <div>
          <h5 class="mb-0 fw-bold">NERACA SALDO (BALANCE SHEET)</h5>
          <small class="text-white-50">Posisi Keuangan · <%= store.settings.nama_usaha %></small>
        </div>
        <button class="btn btn-sm btn-outline-light rounded-pill px-3" onclick="window.print()">
          <i class="fas fa-print me-1"></i>Cetak Neraca
        </button>
      </div>
      <div class="card-body p-4">
        <div class="row g-4">
          <!-- Sisi Kiri: Aset -->
          <div class="col-md-6 border-end">
            <h6 class="fw-bold text-uppercase text-success border-bottom pb-2 mb-3">
              <i class="fas fa-vault me-2"></i>ASET (ASSETS)
            </h6>

            <div class="small fw-bold text-muted text-uppercase mb-2">Aset Lancar (Current Assets)</div>
            <table class="table table-sm table-borderless mb-3">
              <tbody>
                <% asetLancar.forEach(function(a) { %>
                  <tr>
                    <td class="ps-2"><%= a.kode %> - <%= a.nama %></td>
                    <td class="text-end fw-semibold"><%= formatRp(a.saldo) %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>

            <div class="small fw-bold text-muted text-uppercase mb-2 mt-3">Aset Tetap (Fixed Assets)</div>
            <table class="table table-sm table-borderless mb-3">
              <tbody>
                <% asetTetap.forEach(function(a) { %>
                  <tr>
                    <td class="ps-2"><%= a.kode %> - <%= a.nama %></td>
                    <td class="text-end fw-semibold <%= a.saldo < 0 ? 'text-danger' : '' %>"><%= formatRp(a.saldo) %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>

            <div class="card p-3 bg-success-subtle border-success mt-4">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-success">TOTAL ASET</span>
                <span class="fs-5 fw-bold text-success"><%= formatRp(totalAset) %></span>
              </div>
            </div>
          </div>

          <!-- Sisi Kanan: Kewajiban & Ekuitas -->
          <div class="col-md-6">
            <h6 class="fw-bold text-uppercase text-danger border-bottom pb-2 mb-3">
              <i class="fas fa-file-invoice-dollar me-2"></i>KEWAJIBAN & EKUITAS
            </h6>

            <div class="small fw-bold text-muted text-uppercase mb-2">Kewajiban / Liabilitas (Liabilities)</div>
            <table class="table table-sm table-borderless mb-3">
              <tbody>
                <% kewajiban.forEach(function(a) { %>
                  <tr>
                    <td class="ps-2"><%= a.kode %> - <%= a.nama %></td>
                    <td class="text-end fw-semibold"><%= formatRp(a.saldo) %></td>
                  </tr>
                <% }); %>
                <tr class="border-top fw-bold">
                  <td class="ps-2">Total Kewajiban</td>
                  <td class="text-end text-danger"><%= formatRp(totalKewajiban) %></td>
                </tr>
              </tbody>
            </table>

            <div class="small fw-bold text-muted text-uppercase mb-2 mt-4">Ekuitas Modal (Equity)</div>
            <table class="table table-sm table-borderless mb-3">
              <tbody>
                <% ekuitas.forEach(function(a) { %>
                  <tr>
                    <td class="ps-2"><%= a.kode %> - <%= a.nama %></td>
                    <td class="text-end fw-semibold"><%= formatRp(a.saldo) %></td>
                  </tr>
                <% }); %>
                <tr>
                  <td class="ps-2">Laba Bersih Periode Berjalan</td>
                  <td class="text-end fw-semibold text-primary"><%= formatRp(labaBersih) %></td>
                </tr>
                <tr class="border-top fw-bold">
                  <td class="ps-2">Total Ekuitas</td>
                  <td class="text-end text-primary"><%= formatRp(totalEkuitas) %></td>
                </tr>
              </tbody>
            </table>

            <div class="card p-3 bg-primary-subtle border-primary mt-4">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-primary">TOTAL KEWAJIBAN & EKUITAS</span>
                <span class="fs-5 fw-bold text-primary"><%= formatRp(totalPasiva) %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Balance Indicator -->
        <div class="text-center mt-4 pt-3 border-top">
          <% if (isBalance) { %>
            <span class="badge bg-success px-4 py-2 fs-6 rounded-pill">
              <i class="fas fa-check-double me-2"></i>NERACA SEIMBANG (BALANCE)
            </span>
          <% } else { %>
            <span class="badge bg-warning text-dark px-4 py-2 fs-6 rounded-pill">
              <i class="fas fa-triangle-exclamation me-2"></i>Selisih Neraca: <%= formatRp(Math.abs(totalAset - totalPasiva)) %>
            </span>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
