<%- include('partials/header', { pageTitle: 'Dashboard', currentPath: '/' }) %>

<!-- Quick Stats / Golden KPIs -->
<div class="row g-3 mb-4">
  <div class="col-xl-3 col-md-6">
    <div class="card p-3 h-100" style="background:var(--pg);border-color:var(--pgb)">
      <div class="d-flex align-items-center gap-3">
        <div class="kpi-icon" style="background:var(--pgb);color:var(--pgp)">
          <i class="fas fa-wallet"></i>
        </div>
        <div>
          <div class="kpi-lbl" style="color:var(--pgp)">Kas & Bank Tersedia</div>
          <div class="kpi-val" style="color:var(--pgt)"><%= formatRp(summary.totalKasBank) %></div>
          <small class="text-success fw-bold" style="font-size:.7rem"><i class="fas fa-circle-check me-1"></i>3 Rekening Aktif</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="card p-3 h-100" style="background:var(--pb);border-color:var(--pbb)">
      <div class="d-flex align-items-center gap-3">
        <div class="kpi-icon" style="background:var(--pbb);color:var(--pbp)">
          <i class="fas fa-arrow-trend-up"></i>
        </div>
        <div>
          <div class="kpi-lbl" style="color:var(--pbp)">Total Pendapatan</div>
          <div class="kpi-val" style="color:var(--pbt)"><%= formatRp(summary.totalPendapatan) %></div>
          <small class="text-primary fw-bold" style="font-size:.7rem"><i class="fas fa-arrow-up me-1"></i>Periode Berjalan</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="card p-3 h-100" style="background:var(--pr);border-color:var(--prb)">
      <div class="d-flex align-items-center gap-3">
        <div class="kpi-icon" style="background:var(--prb);color:var(--prp)">
          <i class="fas fa-arrow-trend-down"></i>
        </div>
        <div>
          <div class="kpi-lbl" style="color:var(--prp)">Total Pengeluaran</div>
          <div class="kpi-val" style="color:var(--prt)"><%= formatRp(summary.totalBeban + summary.totalHpp) %></div>
          <small class="text-danger fw-bold" style="font-size:.7rem"><i class="fas fa-calculator me-1"></i>HPP & Beban Operasional</small>
        </div>
      </div>
    </div>
  </div>

  <div class="col-xl-3 col-md-6">
    <div class="card p-3 h-100" style="background:var(--py);border-color:var(--pyb)">
      <div class="d-flex align-items-center gap-3">
        <div class="kpi-icon" style="background:var(--pyb);color:var(--pyp)">
          <i class="fas fa-coins"></i>
        </div>
        <div>
          <div class="kpi-lbl" style="color:var(--pyp)">Laba Bersih</div>
          <div class="kpi-val" style="color:var(--pyt)"><%= formatRp(summary.labaBersih) %></div>
          <small class="text-warning fw-bold" style="font-size:.7rem"><i class="fas fa-chart-line me-1"></i>Margin Sehat</small>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Secondary KPIs & Quick Actions -->
<div class="row g-3 mb-4">
  <div class="col-lg-8">
    <div class="card h-100">
      <div class="card-header d-flex align-items-center justify-content-between">
        <span><i class="fas fa-bolt me-2 text-warning"></i>Aksi Cepat Transaksi</span>
        <span class="badge bg-dark rounded-pill">Finansial Pintar</span>
      </div>
      <div class="card-body p-3">
        <div class="row g-2">
          <div class="col-sm-6 col-md-3">
            <a href="/pemasukan" class="btn btn-outline-success w-100 p-3 text-start rounded-3 h-100 d-flex flex-column justify-content-between">
              <div>
                <i class="fas fa-plus-circle fa-lg mb-2 text-success"></i>
                <div class="fw-bold text-dark">Catat Pemasukan</div>
                <small class="text-muted" style="font-size:.72rem">Penjualan & pendapatan</small>
              </div>
              <span class="badge bg-success-subtle text-success mt-2 align-self-start">+ Input</span>
            </a>
          </div>
          <div class="col-sm-6 col-md-3">
            <a href="/pengeluaran" class="btn btn-outline-danger w-100 p-3 text-start rounded-3 h-100 d-flex flex-column justify-content-between">
              <div>
                <i class="fas fa-minus-circle fa-lg mb-2 text-danger"></i>
                <div class="fw-bold text-dark">Catat Pengeluaran</div>
                <small class="text-muted" style="font-size:.72rem">Beban & operasional</small>
              </div>
              <span class="badge bg-danger-subtle text-danger mt-2 align-self-start">- Input</span>
            </a>
          </div>
          <div class="col-sm-6 col-md-3">
            <a href="/pos" class="btn btn-outline-warning w-100 p-3 text-start rounded-3 h-100 d-flex flex-column justify-content-between">
              <div>
                <i class="fas fa-cash-register fa-lg mb-2 text-warning"></i>
                <div class="fw-bold text-dark">Buka Kasir POS</div>
                <small class="text-muted" style="font-size:.72rem">Transaksi cepat kasir</small>
              </div>
              <span class="badge bg-warning-subtle text-dark mt-2 align-self-start">Point of Sale</span>
            </a>
          </div>
          <div class="col-sm-6 col-md-3">
            <a href="/laba-rugi" class="btn btn-outline-primary w-100 p-3 text-start rounded-3 h-100 d-flex flex-column justify-content-between">
              <div>
                <i class="fas fa-file-invoice fa-lg mb-2 text-primary"></i>
                <div class="fw-bold text-dark">Laporan Keuangan</div>
                <small class="text-muted" style="font-size:.72rem">Laba rugi & neraca</small>
              </div>
              <span class="badge bg-primary-subtle text-primary mt-2 align-self-start">Laporan</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-header">
        <span><i class="fas fa-scale-balanced me-2"></i>Tagihan & Kewajiban</span>
      </div>
      <div class="card-body p-3 d-flex flex-column justify-content-around">
        <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background:var(--card-h)">
          <div class="d-flex align-items-center gap-2">
            <i class="fas fa-hand-holding-dollar text-primary fa-lg"></i>
            <div>
              <div class="fw-bold" style="font-size:.82rem">Piutang Pelanggan</div>
              <small class="text-muted" style="font-size:.7rem"><%= piutangCount %> Tagihan Belum Lunas</small>
            </div>
          </div>
          <div class="fw-bold text-primary"><%= formatRp(summary.totalPiutang) %></div>
        </div>

        <div class="d-flex align-items-center justify-content-between p-2 rounded mt-2" style="background:var(--card-h)">
          <div class="d-flex align-items-center gap-2">
            <i class="fas fa-receipt text-danger fa-lg"></i>
            <div>
              <div class="fw-bold" style="font-size:.82rem">Hutang ke Pemasok</div>
              <small class="text-muted" style="font-size:.7rem"><%= hutangCount %> Kewajiban Belum Dibayar</small>
            </div>
          </div>
          <div class="fw-bold text-danger"><%= formatRp(summary.totalHutang) %></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Recent Transactions Table -->
<div class="card">
  <div class="card-header d-flex align-items-center justify-content-between">
    <div>
      <i class="fas fa-clock-rotate-left me-2"></i><strong>Transaksi Finansial Terbaru</strong>
    </div>
    <a href="/daftar-transaksi" class="btn btn-sm btn-outline-dark rounded-pill px-3" style="font-size:.75rem">
      Lihat Semua Transaksi <i class="fas fa-chevron-right ms-1"></i>
    </a>
  </div>
  <div class="table-responsive">
    <table class="table-custom">
      <thead>
        <tr>
          <th>Tanggal</th>
          <th>Tipe</th>
          <th>No. Referensi</th>
          <th>Keterangan / Deskripsi</th>
          <th>Rekening & Akun</th>
          <th class="text-end">Nominal</th>
        </tr>
      </thead>
      <tbody>
        <% if (transactions && transactions.length > 0) { %>
          <% transactions.slice(0, 8).forEach(function(tx) { %>
            <tr>
              <td class="text-nowrap fw-medium"><%= formatTgl(tx.tanggal) %></td>
              <td>
                <% if (tx.tipe === 'PEMASUKAN') { %>
                  <span class="badge rounded-pill bg-success-subtle text-success fw-bold px-2.5 py-1">
                    <i class="fas fa-arrow-down-left me-1"></i>MASUK
                  </span>
                <% } else { %>
                  <span class="badge rounded-pill bg-danger-subtle text-danger fw-bold px-2.5 py-1">
                    <i class="fas fa-arrow-up-right me-1"></i>KELUAR
                  </span>
                <% } %>
              </td>
              <td><code><%= tx.referensi %></code></td>
              <td>
                <div class="fw-semibold"><%= tx.keterangan %></div>
                <small class="text-muted"><%= tx.kontak || '-' %></small>
              </td>
              <td>
                <span class="badge bg-light text-dark border"><%= tx.rekening %></span>
              </td>
              <td class="text-end fw-bold text-nowrap <%= tx.tipe === 'PEMASUKAN' ? 'text-success' : 'text-danger' %>">
                <%= tx.tipe === 'PEMASUKAN' ? '+' : '-' %><%= formatRp(tx.nominal) %>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" class="text-center py-4 text-muted">Belum ada data transaksi.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
